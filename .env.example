# ====================================================================
# ResumeFit Environment Configuration Template
# ====================================================================

# Application
ENVIRONMENT=development
PROJECT_NAME="ResumeFit"
LOG_LEVEL=INFO

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-super-secret-hex-token-min-32-chars-long-for-production!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resumefit_user
POSTGRES_PASSWORD=resumefit_secure_password
POSTGRES_DB=resumefit_db
DATABASE_URL=postgresql+asyncpg://resumefit_user:resumefit_secure_password@localhost:5432/resumefit_db
# Sync DB URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql://resumefit_user:resumefit_secure_password@localhost:5432/resumefit_db

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI & LLM Service Configuration
# Provider choices: "openai", "azure_openai", or "local_heuristic" (offline deterministic mock)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=3000
EMBEDDING_MODEL=text-embedding-3-small

# Match Scoring Weights (Must sum to 1.0)
WEIGHT_REQUIRED_SKILLS=0.40
WEIGHT_EXPERIENCE=0.20
WEIGHT_NICE_TO_HAVE_SKILLS=0.15
WEIGHT_PROJECTS=0.10
WEIGHT_EDUCATION=0.10
WEIGHT_SENIORITY=0.05

# File Storage Configuration
# Storage backend: "local" or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS='[".pdf", ".docx", ".txt"]'

# S3 Compatible Storage (optional when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=resumefit-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=

# Email / Notification Provider
# Choices: "console" (prints reset links to server stdout/logs) or "smtp"
EMAIL_PROVIDER=console
EMAILS_FROM_EMAIL=no-reply@resumefit.io
EMAILS_FROM_NAME="ResumeFit Team"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Rate Limiting
RATE_LIMIT_LOGIN="5/15minute"
RATE_LIMIT_REGISTER="5/hour"
RATE_LIMIT_UPLOAD="10/hour"
RATE_LIMIT_MATCH="20/hour"

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
