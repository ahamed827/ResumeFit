# ====================================================================
# ResumeFit .gitignore - Bulletproof Exclusions for Git
# ====================================================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.env
*.env.*
*.env.local
**/.env
**/.env.*
**/.env.local
!*.env.example

# Local SQLite & Relational Databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
resumefit.db

# User Uploaded Documents & Test Artifacts (PRIVACY & SECURITY)
uploads/
**/uploads/
test_uploads/
**/test_uploads/

# Python Virtual Environments
.venv/
venv/
ENV/
env/
.Python

# Python Bytecode & Build Artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Quality Tooling Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
*.log
logs/

# Node.js & Next.js Frontend
node_modules/
**/node_modules/
frontend/.next/
**/.next/
frontend/out/
frontend/build/
frontend/.turbo/
.npm
*.tsbuildinfo

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
